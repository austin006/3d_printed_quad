{
    "name": "WSL - PX4 ROS2 Environment",
    "image": "frostin/ros2-px4",
    // "build": {
    //     "dockerfile": "Dockerfile.wsl",
    //     // Tells Docker to treat the project root as the build context
    //     "context": "../.."
    // },
    "mounts": [
        "source=${localWorkspaceFolder}/src,target=/root/ros2_ws/src/myproject,type=bind,consistency=cached",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        // Mount WSLg for native Windows hardware accelerated graphics
        "source=/mnt/wslg,target=/mnt/wslg,type=bind"
    ],
    "runArgs": [
        "--env=DISPLAY=${localEnv:DISPLAY}",
        "--ipc=host",
        "--privileged"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "PULSE_SERVER": "${localEnv:PULSE_SERVER}",
        "LIBGL_ALWAYS_INDIRECT": "0"
    },
    
    
    "workspaceFolder": "/root/ros2_ws"
}